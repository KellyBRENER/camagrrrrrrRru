# Copiez ce fichier vers .env dans camagru/ et remplacez les exemples localement.
# Nom de base : lettres ASCII, chiffres et underscore uniquement.
MYSQL_DATABASE=camagru
# Mot de passe administrateur MariaDB ; choisissez un secret propre à votre installation.
MYSQL_ROOT_PASSWORD=remplacer-par-un-secret-local

# L'image PHP utilise Gmail SMTP via msmtp (smtp.gmail.com:587).
# Adresse du compte Gmail et mot de passe d'application correspondants.
SMTP_USER=adresse@example.com
SMTP_PASS=remplacer-par-un-mot-de-passe-application

# Adresse de repli pour les liens envoyés par email, accessible au destinataire.
APP_URL=http://localhost:8081
# Origines supplémentaires autorisées pour ces liens, séparées par des virgules.
# Inclure le protocole et le port ; retirer les origines non utilisées.
APP_ALLOWED_ORIGINS=http://localhost:8081,https://localhost:8443
